.visitor-launcher{position:fixed;z-index:60;right:max(24px,env(safe-area-inset-right));bottom:max(24px,env(safe-area-inset-bottom));width:68px;height:68px;border:0;border-radius:50%;display:grid;place-items:center;background:linear-gradient(145deg,#ff9c36,#d94b00);color:#fff;box-shadow:0 12px 30px #a9401d55;cursor:pointer;transition:transform .2s ease,box-shadow .2s ease}
.visitor-launcher:hover{transform:translateY(-3px) scale(1.03);box-shadow:0 16px 34px #a9401d66}
.visitor-launcher>.material-symbols-outlined{font-size:31px}
.visitor-launcher__badge{position:absolute;top:-3px;right:-2px;min-width:23px;height:23px;padding:0 5px;border-radius:50px;display:grid;place-items:center;background:#b42318;color:#fff;font:700 12px/1 sans-serif;border:2px solid #fff}
.visitor-launcher__hint{position:absolute;right:78px;white-space:nowrap;padding:9px 13px;border-radius:10px;background:#fff;color:#803900;font:700 12px/1.2 sans-serif;box-shadow:0 5px 20px #38220e22;opacity:0;transform:translateX(5px);transition:opacity .2s ease,transform .2s ease;pointer-events:none}
.visitor-launcher:hover .visitor-launcher__hint,.visitor-launcher:focus-visible .visitor-launcher__hint{opacity:1;transform:translateX(0)}
.visitor-chat{position:fixed;z-index:61;right:max(24px,env(safe-area-inset-right));bottom:104px;width:min(410px,calc(100vw - 32px));height:min(620px,calc(100dvh - 132px));display:flex;flex-direction:column;overflow:hidden;border:1px solid #eadfd6;border-radius:22px;background:#fff;box-shadow:0 22px 70px #2f1b1233;color:#342b26;font-family:inherit}
.visitor-chat__header{display:flex;align-items:center;gap:12px;padding:15px 16px;background:linear-gradient(120deg,#fff9f3,#fff);border-bottom:1px solid #f0e7e1;flex:0 0 auto}
.visitor-chat__header img{width:42px;height:42px;object-fit:contain;border-radius:50%;background:#fff;padding:3px}
.visitor-chat__header div{min-width:0;flex:1;display:grid;gap:4px}.visitor-chat__header strong{font-size:14px}.visitor-chat__header span{font-size:11px;color:#86766b}
.visitor-chat__header button{border:0;background:transparent;color:#8a4a17;cursor:pointer}.visitor-chat__header button .material-symbols-outlined{font-size:25px}
.visitor-welcome{padding:20px;display:grid;gap:15px;overflow:auto}.visitor-welcome__intro{margin:0;padding:14px 15px;border-radius:14px;background:#fff4e8;color:#684321;font-size:13px;line-height:1.55}
.visitor-welcome label{display:grid;gap:7px;color:#5b4a3e;font-size:12px;font-weight:700}.visitor-welcome label span{color:#9a8d82;font-weight:400}.visitor-welcome input:not([type=radio]){width:100%;box-sizing:border-box;border:1px solid #e7d9cd;border-radius:11px;padding:11px 12px;font:inherit;font-weight:400;outline:none}.visitor-welcome input:focus{border-color:#dc7a25;box-shadow:0 0 0 3px #dc7a251a}
.visitor-welcome fieldset{display:grid;grid-template-columns:1fr 1fr;gap:7px;border:0;padding:0;margin:0}.visitor-welcome legend{grid-column:1/-1;margin-bottom:3px;font-size:12px;font-weight:700;color:#5b4a3e}.visitor-welcome .visitor-choice{display:flex;align-items:center;gap:7px;padding:9px;border:1px solid #eee3db;border-radius:10px;font-size:11px}.visitor-welcome .visitor-choice:last-child{grid-column:1/-1}.visitor-welcome .visitor-choice input{accent-color:#d96a16}
.visitor-privacy{font-size:10px;line-height:1.5;color:#88796f;margin:0}.visitor-primary{border:0;border-radius:11px;background:linear-gradient(120deg,#e87919,#c84e04);color:white;font-weight:700;padding:12px;cursor:pointer}.visitor-primary:disabled{opacity:.65;cursor:wait}
.visitor-request-link{border:0;background:transparent;color:#a94c0c;text-decoration:underline;font:inherit;font-size:11px;cursor:pointer}
.visitor-chat__history{flex:1;min-height:0;overflow:auto;padding:15px 13px;background:#fcfaf8}.visitor-chat__loading,.visitor-chat__empty{flex:1;display:grid;place-content:center;text-align:center;padding:24px;color:#87776c;font-size:13px}.visitor-chat__empty .material-symbols-outlined{font-size:32px;color:#d4772d}.visitor-date{display:flex;align-items:center;gap:10px;margin:7px 0 14px;color:#95877d;font-size:10px;justify-content:center}.visitor-date span{background:#fcfaf8;padding:0 8px}
.visitor-message{display:flex;align-items:flex-end;gap:7px;margin:9px 0;max-width:88%}.visitor-message.is-own{margin-left:auto;justify-content:flex-end}.visitor-message>img{width:25px;height:25px;object-fit:contain;border-radius:50%;background:#fff}.visitor-message__body p{margin:0;padding:10px 12px;border-radius:16px 16px 16px 5px;background:#f0ece8;color:#443a34;white-space:pre-wrap;overflow-wrap:anywhere;font-size:13px;line-height:1.45}.visitor-message.is-own .visitor-message__body p{border-radius:16px 16px 5px 16px;background:linear-gradient(135deg,#ed8b32,#d45b12);color:white}.visitor-message time{display:block;padding:4px 5px 0;color:#95877d;font-size:9px}.visitor-message.is-own time{text-align:right}
.visitor-composer{flex:0 0 auto;padding:10px 12px max(10px,env(safe-area-inset-bottom));border-top:1px solid #eee6e0;background:#fff}.visitor-composer>div{display:flex;align-items:flex-end;gap:8px;padding:7px 8px 7px 12px;border:1px solid #e6dbd2;border-radius:15px}.visitor-composer textarea{resize:none;min-height:24px;max-height:120px;flex:1;border:0;outline:0;font:inherit;font-size:13px;line-height:1.5}.visitor-composer button{width:35px;height:35px;border:0;border-radius:11px;background:#d96316;color:white;display:grid;place-items:center;cursor:pointer}.visitor-composer button:disabled{opacity:.5;cursor:default}.visitor-composer small{display:block;padding:6px 3px 0;color:#9a8d82;font-size:9px}.visitor-chat__error,.visitor-chat__expired{margin:0;color:#a12c22;font-size:11px;line-height:1.4}
@media(max-width:600px){.visitor-launcher{right:max(16px,env(safe-area-inset-right));bottom:max(16px,env(safe-area-inset-bottom));width:60px;height:60px}.visitor-launcher__hint{display:none}.visitor-chat{inset:0;width:100%;height:100%;height:100dvh;max-height:100dvh;border-radius:0;border:0;padding-bottom:env(safe-area-inset-bottom)}.visitor-chat__header{padding-top:max(14px,env(safe-area-inset-top))}.visitor-welcome{padding:18px}.visitor-chat__history{padding:12px}}
@media(prefers-reduced-motion:reduce){.visitor-launcher,.visitor-launcher__hint{transition:none}}
